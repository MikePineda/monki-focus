# Environment of the server under E2E (sourced by scripts/e2e.sh, which adds
# the slot's PORT, APP_URL, DB_PORT and NTFY_BASE_URL). Test-only values:
# nothing here is real or reused anywhere else.
#
# NODE_ENV=test keeps cheap hashing and plain cookies over http://127.0.0.1;
# E2E_MODE registers the test-support routes (/api/test/*).
NODE_ENV=test
E2E_MODE=true
TZ=UTC
HOST=127.0.0.1
LOG_LEVEL=warn
APP_KEY=test-key-not-real-e2e-stack-only
APP_NAME=monki-focus-e2e
APP_DEFAULT_LOCALE=en
REGISTRATION_OPEN=false
SESSION_DRIVER=cookie
LIMITER_STORE=database
CLIENT_IP_HEADER=
DB_HOST=127.0.0.1
DB_USER=monkifocus
DB_PASSWORD=monkifocus
DB_DATABASE=monkifocus_test
SCHEDULER=off
LLM_PROVIDER=fake
