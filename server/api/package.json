{
  "name": "@monki-focus/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "monki-focus optional self-hostable server: guardian unlocks, analytics sync and reports (AdonisJS).",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node --import=@poppinss/ts-exec --enable-source-maps bin/test.ts",
    "test:unit": "node --import=@poppinss/ts-exec --enable-source-maps bin/test.ts unit",
    "test:services": "docker compose -f ../../docker-compose.test.yml up -d --wait",
    "test:services:down": "docker compose -f ../../docker-compose.test.yml down -v",
    "smoke:local": "bash bin/smoke.sh local",
    "smoke:prod": "bash bin/smoke.sh prod",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#commands/*": "./commands/*.js",
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#validators/*": "./app/validators/*.js",
    "#transformers/*": "./app/transformers/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#domain/*": "./app/domain/*.js",
    "#http/*": "./app/http/*.js",
    "#logging/*": "./app/logging/*.js",
    "#scheduler/*": "./app/scheduler/*.js",
    "#services/*": "./app/services/*.js",
    "#providers/*": "./providers/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "dependencies": {
    "@adonisjs/auth": "10.1.0",
    "@adonisjs/core": "7.6.0",
    "@adonisjs/cors": "3.0.0",
    "@adonisjs/i18n": "3.0.1",
    "@adonisjs/limiter": "3.0.1",
    "@adonisjs/lucid": "22.4.2",
    "@adonisjs/session": "8.3.0",
    "@adonisjs/shield": "9.0.0",
    "@monki-focus/protocol": "0.0.0",
    "@vinejs/vine": "4.4.0",
    "luxon": "3.7.2",
    "pg": "8.23.1",
    "proxy-addr": "2.0.8",
    "reflect-metadata": "0.2.2",
    "tldts": "7.4.19"
  },
  "devDependencies": {
    "@adonisjs/assembler": "8.6.0",
    "@adonisjs/eslint-config": "3.1.0",
    "@adonisjs/tsconfig": "2.0.0",
    "@japa/api-client": "3.2.1",
    "@japa/assert": "4.2.0",
    "@japa/plugin-adonisjs": "5.2.0",
    "@japa/runner": "5.4.0",
    "@poppinss/ts-exec": "1.5.1",
    "@types/luxon": "3.7.6",
    "@types/node": "^26.6.5",
    "@types/pg": "8.23.1",
    "@types/proxy-addr": "2.0.3",
    "ajv": "8.20.0",
    "eslint": "10.13.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "yaml": "2.9.1"
  }
}
