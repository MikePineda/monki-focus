# Committed on purpose: test-only values, no real secrets. Loaded on top of
# `.env` when NODE_ENV=test (Japa). In CI there is no `.env`, so every
# required variable of start/env_schema.ts has a value here or in the job env;
# process variables (the CI job's DB_* and NTFY_*) win over this file.
# Locally: `npm run test:services -w server/api` starts docker-compose.test.yml
# (Postgres on 5443, ntfy on 8443, both in tmpfs).
TZ=UTC
HOST=127.0.0.1
PORT=3333
LOG_LEVEL=error
# Fixed key for the test suite only; it never encrypts anything real.
APP_KEY=test-key-not-real-japa-suite-only
APP_URL=http://127.0.0.1:3333
APP_NAME=monki-focus
APP_DEFAULT_LOCALE=en
REGISTRATION_OPEN=false
SESSION_DRIVER=memory
LIMITER_STORE=memory
CLIENT_IP_HEADER=
DB_HOST=127.0.0.1
DB_PORT=5443
DB_USER=monkifocus
DB_PASSWORD=monkifocus
DB_DATABASE=monkifocus_test
NTFY_BASE_URL=http://127.0.0.1:8443
LLM_PROVIDER=fake
LLM_API_KEY=
