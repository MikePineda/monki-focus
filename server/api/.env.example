# monki-focus server environment. Copy to `.env` for local development:
#   cp server/api/.env.example server/api/.env
#   (cd server/api && node ace generate:key)    # fills APP_KEY
# The values below work with the root docker-compose.yml (Postgres on 5442,
# ntfy on 8442). Production values live ONLY in your deploy panel or your own
# `.env`, never in the repository. Every variable is validated at boot by
# start/env_schema.ts (tests/unit/env_example.spec.ts keeps both lists equal).
# An empty optional value means "off" or "use the built-in default".

#--------------------------------------------------------------------
# App
#--------------------------------------------------------------------
# development | production | test. The Docker image sets production.
NODE_ENV=development
# Keep UTC: every timestamp is stored in UTC; days and weeks use each
# user's own time zone.
TZ=UTC
# Address to listen on. The container uses 0.0.0.0.
HOST=localhost
# Dev port. The Docker image listens on 3333.
PORT=3433
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Encryption key for sessions, the CSRF cookie and signing keys at rest.
# Generate with `node ace generate:key`. Rotating it signs every user out.
APP_KEY=
# Public URL of this instance, without a trailing slash. It is the token
# issuer and the base of notification action links, e.g. https://focus.example.org
APP_URL=http://localhost:3433
# Logger name. Empty = monki-focus.
APP_NAME=
# Empty = read from the Docker image (.app-version / .git-sha), else dev/unknown.
APP_VERSION=
GIT_SHA=
# Language when neither the user nor the browser picks a supported one: en | es
APP_DEFAULT_LOCALE=en
# Where users can get the source of the version you run (AGPL-3.0 §13).
# Point it at your fork when you change the code.
SOURCE_URL=
# Public sign-up. Empty or false = closed: the first admin comes from
# SEED_ADMIN_*, everyone else joins with an invitation or a pairing code.
REGISTRATION_OPEN=false
# Session storage: cookie (encrypted, stateless) | memory (tests only)
SESSION_DRIVER=cookie
# Rate-limit storage: database (rate_limits table) | memory (tests only)
LIMITER_STORE=database
# Header carrying the real client IP, set by YOUR CDN or edge proxy, for
# example cf-connecting-ip behind Cloudflare. Empty = the address your local
# proxy forwarded (X-Forwarded-For from loopback/private proxies only).
# Your edge must strip or overwrite this header on every request
# (docs/RUNBOOK.md, "Client IP behind a CDN").
CLIENT_IP_HEADER=
# Comma-separated CIDRs allowed to set CLIENT_IP_HEADER: the CDN's own
# ranges as your local proxy sees them. Behind Cloudflare, paste its IPv4
# and IPv6 lists (published at www.cloudflare.com/ips). Empty = the header
# is never trusted.
CLIENT_IP_HEADER_FROM=
# Registers the test-support routes (/api/test/*) outside NODE_ENV=test.
# For the E2E stack only; refused on a public URL in production.
E2E_MODE=

#--------------------------------------------------------------------
# Database (Postgres 17)
#--------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5442
DB_USER=monkifocus
# Local docker-compose.yml value; use a generated password anywhere else.
DB_PASSWORD=monkifocus
DB_DATABASE=monkifocus
# Connection pool size per process (1-100). Empty = 10.
DB_POOL_MAX=

#--------------------------------------------------------------------
# Boot and seed (docker/entrypoint.mjs)
#--------------------------------------------------------------------
# Run `node ace migration:run --force` before the server starts. Safe with one
# replica (migrations are additive); with more, migrate out of band.
MIGRATE_ON_START=false
# In-process scheduler (production only): empty or on = runs, off = disabled.
SCHEDULER=
# Create the first admin (and the smoke user) on start. Idempotent: an
# existing account keeps its password. The passwords must pass the policy
# (12+ characters, not a common word), or the container refuses to start.
# Turn it off after the first deploy.
SEED_USERS=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=
# en | es
SEED_ADMIN_LOCALE=
# IANA time zone, e.g. Etc/UTC or America/New_York
SEED_ADMIN_TIME_ZONE=
# Smoke user for the post-deploy Bruno run (server/api/bruno).
SMOKE_EMAIL=
SMOKE_PASSWORD=
SMOKE_DEVICE_TOKEN=

#--------------------------------------------------------------------
# Unlocks and protection
#--------------------------------------------------------------------
# Optional Ed25519 signing key for unlock tokens. Empty = the server
# generates one and stores it encrypted with APP_KEY.
UNLOCK_SIGNING_KEY=
UNLOCK_SIGNING_KEY_ID=
# Longest unlock a guardian can grant, in minutes (1-240). Empty = 120.
UNLOCK_TOKEN_MAX_MINUTES=
# How long a guardian has to answer an unlock request (1-60). Empty = 15.
UNLOCK_REQUEST_TTL_MINUTES=
# Lifetime of a guardian pairing code (1-60). Empty = 10.
PAIRING_CODE_TTL_MINUTES=
# Hours without heartbeat before the guardian hears a device went quiet (1-48). Empty = 6.
DEADMAN_DEFAULT_HOURS=
# Delay before a ward's own guardian revocation takes effect (0-168). Empty = 24.
WARD_REVOCATION_COOLDOWN_HOURS=
# Oldest client accepted per platform (semver, e.g. 0.3.0). Older clients get
# HTTP 426 and keep enforcing locally. Empty = any version.
MIN_CLIENT_VERSION_EXTENSION=
MIN_CLIENT_VERSION_ANDROID=
MIN_CLIENT_VERSION_MACOS=

#--------------------------------------------------------------------
# Retention (a daily job prunes older rows)
#--------------------------------------------------------------------
# Empty = 30
HEARTBEAT_RETENTION_DAYS=
# Empty = 400
ACTIVITY_RETENTION_DAYS=

#--------------------------------------------------------------------
# ntfy (guardian notifications)
#--------------------------------------------------------------------
# Where the server publishes (an internal address is fine).
NTFY_BASE_URL=http://127.0.0.1:8442
# What guardians subscribe to from their phones. Empty = NTFY_BASE_URL.
NTFY_PUBLIC_URL=
# Access token with write access to the topic prefix. Empty = anonymous
# publishing (local ntfy only).
NTFY_PUBLISH_TOKEN=
# Prefix of every topic this server creates. Empty = mf-
NTFY_TOPIC_PREFIX=

#--------------------------------------------------------------------
# LLM (optional weekly report). Empty LLM_API_KEY = no LLM; everything else works.
#--------------------------------------------------------------------
# anthropic-compatible | anthropic | fake (tests)
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Model calls per user and month. Empty = 30.
LLM_MONTHLY_CAP=
# Empty = true (only when an LLM is configured)
WEEKLY_REPORT_ENABLED=

#--------------------------------------------------------------------
# Digest (optional, off by default)
#--------------------------------------------------------------------
DIGEST_ENABLED=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

#--------------------------------------------------------------------
# Observability (optional)
#--------------------------------------------------------------------
SENTRY_DSN=
SENTRY_DSN_WEB=
