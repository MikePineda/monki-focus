{
  "name": "monki-focus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "monki-focus: an open-source, local-first anti-doomscroll toolkit (browser extension, Android and macOS apps, optional self-hostable server).",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MikePineda/monki-focus.git"
  },
  "workspaces": [
    "packages/*",
    "server/api",
    "server/web",
    "extension",
    "e2e"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "node scripts/verify.mjs",
    "verify:quick": "node scripts/verify.mjs --quick",
    "verify:all": "node scripts/verify.mjs --all",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "~6.0.3"
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "lefthook": true,
    "@swc/core": false
  }
}
