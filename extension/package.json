{
  "name": "@monki-focus/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "monki-focus Chromium MV3 extension: feed hiding, intention gate and local analytics.",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "prepare:wxt": "wxt prepare",
    "dev": "wxt",
    "build": "wxt build",
    "build:dev": "wxt build --mode development",
    "build:e2e": "wxt build --mode e2e",
    "zip": "wxt zip",
    "lint": "eslint .",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "wxt prepare && vitest run",
    "e2e": "npm run build:e2e && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-plugin-i18next": "6.1.5",
    "globals": "17.13.0",
    "selfsigned": "5.5.0",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wxt": "0.21.4"
  },
  "dependencies": {
    "preact": "11.0.2"
  }
}
