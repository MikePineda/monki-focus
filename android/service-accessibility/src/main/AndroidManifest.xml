<!--
  The accessibility module requests no permission of its own: it reads the
  screen, so it must not also be able to send anything anywhere.

  - MonkiAccessibilityService is exported only to holders of
    BIND_ACCESSIBILITY_SERVICE, which only the system holds. Its config
    (res/xml/accessibility_service_config.xml) names every package it may
    read; nothing else is ever delivered to it.
  - GateActivity, the keyboard fallback of the gate prompt, is not exported:
    only the service starts it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <service
            android:name=".platform.MonkiAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <activity
            android:name=".platform.GateActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity="dev.monkifocus.gate"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
