    <string name="notice_action_exit">Exit and unlink</string>

    <!-- Device admin (uninstall friction only, no policies). -->
    <string name="device_admin_description">Adds one step before monki-focus can be uninstalled. It sets no device policies. You can turn it off any time with Exit and unlink.</string>
    <string name="device_admin_disable_warning">Turning this off is recorded as a bypass. Exit and unlink in the app ends protection without one.</string>

