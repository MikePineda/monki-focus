    <!-- Onboarding (plan 01 §4). -->
    <string name="onboarding_step_count">Step %1$d of %2$d</string>
    <string name="onboarding_welcome_title">Welcome to monki-focus</string>
    <string name="onboarding_welcome_body">monki-focus helps you keep the promises you make to yourself about feeds, Reels and Shorts. It runs on this phone, needs no account and is free software (AGPL).</string>
    <string name="onboarding_welcome_is">What it is: a commitment you choose. You set the rules, and you can always leave with Exit and unlink.</string>
    <string name="onboarding_welcome_is_not">What it is not: monitoring. Nobody watches your screen. If you link a guardian later, they see only your score, unlocks and bypasses, never what you read, watch or type.</string>
    <string name="onboarding_disclosure_title">How monki-focus uses Accessibility</string>
    <string name="onboarding_disclosure_intro">monki-focus uses Android’s Accessibility service to enforce the rules you set. Before you turn it on, here is exactly what it does.</string>
    <string name="onboarding_disclosure_reads_title">What it reads</string>
    <string name="onboarding_disclosure_reads_apps">The structure of the screen (which kind of screen is open) in Instagram, YouTube, your browsers and Android Settings: to tell Reels and Shorts apart and to protect its own settings.</string>
    <string name="onboarding_disclosure_reads_url">In browsers, only the text of the address bar, reduced at once to the site and the first part of the path (for example reddit.com/r).</string>
    <string name="onboarding_disclosure_never_title">What it never does</string>
    <string name="onboarding_disclosure_never_store">It never reads or keeps your messages, posts or what you type, and stores no screen text.</string>
    <string name="onboarding_disclosure_never_send">It sends nothing anywhere: the app has no internet permission. Everything stays on this phone.</string>
    <string name="onboarding_disclosure_never_other">Apps without rules are not read.</string>
    <string name="onboarding_disclosure_leave">You can turn it off at any time with Exit and unlink.</string>
    <string name="onboarding_disclosure_agree">I agree</string>
    <string name="onboarding_disclosure_not_now">Not now</string>
    <string name="onboarding_disclosure_declined">Without Accessibility, monki-focus cannot block anything. You can still use it for usage statistics, or agree later from the Status screen.</string>
    <string name="onboarding_disclosure_stats_only">Continue with statistics only</string>
    <string name="onboarding_restricted_title">Allow restricted settings</string>
    <string name="onboarding_restricted_body">On Android 13 and later, the Accessibility switch can be greyed out for apps installed outside an app store. To allow it:</string>
    <string name="onboarding_restricted_step_try">1. Try to turn on monki-focus in Accessibility once (the next step).</string>
    <string name="onboarding_restricted_step_open">2. Open the App info of monki-focus.</string>
    <string name="onboarding_restricted_step_menu">3. Tap ⋮ (top right), then Allow restricted settings, and confirm.</string>
    <string name="onboarding_restricted_step_back">4. Come back here.</string>
    <string name="onboarding_restricted_hint">If ⋮ does not show, try turning on the service in Accessibility first: the menu appears after that.</string>
    <string name="onboarding_restricted_detected">Android reports that restricted settings are on for monki-focus.</string>
    <string name="onboarding_restricted_likely">monki-focus was installed outside an app store, so this is probably needed.</string>
    <string name="onboarding_restricted_done">Restricted settings are allowed.</string>
    <string name="onboarding_restricted_open">Open App info</string>
    <string name="onboarding_notifications_title">Allow the protection notice</string>
    <string name="onboarding_notifications_body">While protection is on, monki-focus always shows a notice, so it never runs unseen. It also warns you before bedtime.</string>
    <string name="onboarding_notifications_allow">Allow notifications</string>
    <string name="onboarding_notifications_done">Notifications are on.</string>
    <string name="onboarding_notifications_denied">Notifications are still off. Protection needs its notice: turn them on in the app’s notification settings.</string>
    <string name="onboarding_notifications_settings">Open notification settings</string>
    <string name="onboarding_accessibility_title">Turn on the Accessibility service</string>
    <string name="onboarding_accessibility_body">In Settings, tap monki-focus, then turn on Use monki-focus. Come back here when it is on.</string>
    <string name="onboarding_accessibility_open">Open Accessibility settings</string>
    <string name="onboarding_accessibility_done">The service is on.</string>
    <string name="onboarding_accessibility_denied">The service is still off. If the switch was greyed out or Android said Restricted setting, allow restricted settings first.</string>
    <string name="onboarding_usage_title">Usage access (optional)</string>
    <string name="onboarding_usage_body">Lets monki-focus show how long you spend in each app, on this phone only. Without it, statistics stay empty; blocking still works.</string>
    <string name="onboarding_usage_open">Open Usage access</string>
    <string name="onboarding_usage_done">Usage access is on.</string>
    <string name="onboarding_usage_denied">Usage access is off, so statistics stay empty. You can allow it later from Status.</string>
    <string name="onboarding_battery_title">Keep protection running</string>
    <string name="onboarding_battery_body">Some phones stop background apps to save battery. Let monki-focus run without battery restrictions.</string>
    <string name="onboarding_battery_allow">Allow unrestricted battery</string>
    <string name="onboarding_battery_done">Battery optimisation is off for monki-focus.</string>
    <string name="onboarding_battery_denied">monki-focus is still optimised: the service may be stopped.</string>
    <string name="onboarding_battery_guide">More for your phone (dontkillmyapp.com)</string>
    <string name="onboarding_battery_samsung">On Samsung: Settings › Battery › Background usage limits › Never sleeping apps, then add monki-focus.</string>
    <string name="onboarding_battery_xiaomi">On Xiaomi: App info of monki-focus › Battery saver › No restrictions, and turn on Autostart.</string>
    <string name="onboarding_battery_huawei">On Huawei and Honor: Settings › Battery › App launch › monki-focus › Manage manually, with every switch on.</string>
    <string name="onboarding_battery_oppo">On OPPO, OnePlus and realme: App info of monki-focus › Battery › Allow background activity.</string>
    <string name="onboarding_battery_vivo">On vivo: Settings › Battery › Background power consumption management › monki-focus › Allow.</string>
    <string name="onboarding_battery_generic">If your phone adds its own battery saver, allow monki-focus to run in the background there too.</string>
    <string name="onboarding_admin_title">Uninstall protection (optional)</string>
    <string name="onboarding_admin_body">Adds one step before monki-focus can be uninstalled: Android asks to turn this off first. It sets no device policies and can do nothing else. Exit and unlink removes it after its 2-minute wait.</string>
    <string name="onboarding_admin_enable">Turn on uninstall protection</string>
    <string name="onboarding_admin_done">Uninstall protection is on.</string>
    <string name="onboarding_admin_denied">Uninstall protection is off. That is fine: it is optional.</string>
    <string name="onboarding_turn_on_title">Turn on protection</string>
    <string name="onboarding_turn_on_body">Everything required is ready. Your rules apply from now on; a change that loosens them always waits until the next day.</string>
    <string name="onboarding_turn_on_missing">Still needed before protection can start:</string>
    <string name="onboarding_stats_title">You’re set</string>
    <string name="onboarding_stats_body">monki-focus shows usage statistics only. Nothing is blocked. You can turn protection on later from the Status screen.</string>
    <string name="onboarding_finish">Finish</string>
