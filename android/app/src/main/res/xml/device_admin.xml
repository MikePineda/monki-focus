<!--
  Uninstall friction only: no policies at all, so device admin can neither
  lock, wipe nor watch anything. While active, Android asks to deactivate
  it before the app can be uninstalled; "Exit and unlink" removes it.
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies />
</device-admin>
