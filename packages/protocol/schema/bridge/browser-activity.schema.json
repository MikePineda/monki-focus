{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:monki-focus:protocol:bridge-browser-activity:v1",
  "title": "browser.activity (extension to app)",
  "description": "One web tab heartbeat, exactly as the extension records it: an ActivityWatch event with web tab data (packages/rules activity.schema.json#/$defs/event and #/$defs/webTabData, restated here so this contract stands alone). The path never holds a query or fragment (enforced here, stricter than the analytics schema); the title is present only when the user turned titles on, and never for incognito. The app merges it into its web bucket with the same pulsetime.",
  "type": "object",
  "additionalProperties": false,
  "required": ["timestamp", "duration", "data"],
  "properties": {
    "timestamp": {
      "description": "UTC instant with whole seconds.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "duration": {
      "description": "Seconds.",
      "type": "integer",
      "minimum": 0,
      "maximum": 86400
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "path", "surface", "audible", "incognito"],
      "properties": {
        "domain": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+([a-z]{2,63}|xn--[a-z0-9-]{1,59})$"
        },
        "path": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^/[^?#]*$"
        },
        "surface": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9]*\\.[a-z][a-z0-9_]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "audible": {
          "type": "boolean"
        },
        "incognito": {
          "type": "boolean"
        },
        "title": {
          "type": "string",
          "maxLength": 1024
        }
      }
    }
  }
}
