{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:monki-focus:protocol:bridge-bypass-event:v1",
  "title": "bypass.event (extension to app)",
  "description": "An emergency override the user took in the browser, for the app to report like its own (the device API `BypassEvent` of openapi.yaml, kind emergency_override). Only enums and bounded integers: no domain, path, title or text fits.",
  "type": "object",
  "additionalProperties": false,
  "required": ["dedupeKey", "kind", "occurredAt"],
  "properties": {
    "dedupeKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,96}$"
    },
    "kind": {
      "const": "emergency_override"
    },
    "occurredAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "enum": ["rule", "bedtime"]
        },
        "waitSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "durationSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        }
      }
    }
  }
}
