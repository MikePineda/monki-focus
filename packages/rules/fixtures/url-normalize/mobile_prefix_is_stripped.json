{
  "id": "url-normalize.mobile_prefix_is_stripped",
  "kind": "url-normalize",
  "description": "Text without a scheme gets `https://`; the `m.` label is dropped.",
  "given": {
    "urlText": "m.youtube.com/shorts/abc123DEF45"
  },
  "then": {
    "host": "youtube.com",
    "path": "/shorts/abc123DEF45",
    "pathKnown": true,
    "surface": "youtube.shorts"
  }
}
