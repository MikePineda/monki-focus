          "path": "/r/MachineLearning",
          "surface": "reddit.feed",
          "audible": false,
          "incognito": false
        }
      }
    ],
    "extensionLastHeartbeatAt": "2026-10-26T10:10:00Z"
  },
  "then": {
    "segments": [
      {
        "start": "2026-10-26T10:00:00Z",
        "end": "2026-10-26T10:10:00Z",
