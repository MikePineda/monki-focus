{
  "name": "@monki-focus/rules",
  "version": "0.0.0",
  "description": "Rule set JSON Schemas, surfaces, site profiles, default categories and cross-platform conformance fixtures for monki-focus.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pure": {
      "types": "./dist/pure.d.ts",
      "default": "./dist/pure.js"
    },
    "./validator": {
      "types": "./dist/SchemaValidator.d.ts",
      "default": "./dist/SchemaValidator.js"
    },
    "./schema/v1/*": "./schema/v1/*",
    "./data/*": "./data/*",
    "./fixtures/*": "./fixtures/*",
    "./detectors/*": "./detectors/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "data",
    "detectors",
    "fixtures",
    "SEMANTICS.md"
  ],
  "scripts": {
    "generate": "node scripts/generate-types.ts",
    "build": "node scripts/generate-types.ts && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.pure.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "json-schema-to-typescript": "16.0.0",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
