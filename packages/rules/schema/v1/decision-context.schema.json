{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monkifocus.dev/schema/rules/v1/decision-context.schema.json",
  "title": "DecisionContext",
  "description": "Inputs of `decide` besides the rule set, the clock and the time zone.",
  "$defs": {
    "observation": {
      "title": "Observation",
      "description": "What the user is about to see: raw URL text (normalised by the engine) or an app with the surface its detector resolved.",
      "oneOf": [
        {
          "$ref": "#/$defs/siteObservation"
        },
        {
          "$ref": "#/$defs/appObservation"
        }
      ]
    },
    "siteObservation": {
      "title": "SiteObservation",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "urlText"],
      "properties": {
        "kind": {
          "const": "site"
        },
        "urlText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "appObservation": {
      "title": "AppObservation",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "package", "surface"],
      "properties": {
        "kind": {
          "const": "app"
        },
        "package": {
          "$ref": "target.schema.json#/$defs/appPackage"
        },
        "surface": {
          "oneOf": [
            {
              "$ref": "target.schema.json#/$defs/surfaceId"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "verifiedUnlock": {
      "title": "VerifiedUnlock",
      "description": "An unlock whose token an adapter already verified (signature, device, replay). The engine only checks its time window and target.",
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "notBefore", "expiresAt"],
      "properties": {
        "target": {
          "$ref": "target.schema.json"
        },
        "notBefore": {
          "$ref": "time.schema.json#/$defs/instant"
        },
        "expiresAt": {
          "$ref": "time.schema.json#/$defs/instant"
        }
      }
    },
    "dailyUsage": {
      "title": "DailyUsage",
      "description": "Active seconds spent today per budgeted rule. Ignored when `localDate` is not today's local date.",
      "type": "object",
      "additionalProperties": false,
      "required": ["localDate", "secondsByRule"],
      "properties": {
        "localDate": {
          "$ref": "time.schema.json#/$defs/localDate"
        },
        "secondsByRule": {
          "type": "object",
          "maxProperties": 500,
          "propertyNames": {
            "$ref": "rule.schema.json#/$defs/ruleId"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400
          }
        }
      }
    },
    "state": {
      "title": "DecisionState",
      "type": "object",
      "additionalProperties": false,
      "required": ["escalation", "usage", "unlocks", "guardianLinked"],
      "properties": {
        "escalation": {
          "description": "At most one state per target group; a missing group is the initial idle state.",
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "escalation.schema.json#/$defs/state"
          },
          "x-uniqueBy": "/targetGroup"
        },
        "usage": {
          "oneOf": [
            {
              "$ref": "#/$defs/dailyUsage"
            },
            {
              "type": "null"
            }
          ]
        },
        "unlocks": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/verifiedUnlock"
          }
        },
        "guardianLinked": {
          "type": "boolean"
        },
        "pendingEffectiveFrom": {
          "description": "`effectiveFrom` of the rule change that waits (SEMANTICS.md §8), or null when none waits. `decide` never applies it; `validUntil` stops there so the adapter re-decides with the new effective rule set (§5.6).",
          "oneOf": [
            {
              "$ref": "time.schema.json#/$defs/instant"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
