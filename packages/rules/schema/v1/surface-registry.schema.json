{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monkifocus.dev/schema/rules/v1/surface-registry.schema.json",
  "title": "SurfaceRegistry",
  "description": "Canonical list of surfaces (data/surfaces.json). A surface resolves the same way in an app (through a detector pack) and on the web (through a site profile).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "surfaces"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/surface"
      },
      "x-uniqueBy": "/id"
    }
  },
  "$defs": {
    "surfaceKind": {
      "title": "SurfaceKind",
      "description": "`feed` can be hidden; `permalink` and `utility` (search, messages) are never hidden.",
      "type": "string",
      "enum": ["feed", "permalink", "utility"]
    },
    "surface": {
      "title": "Surface",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "kind"],
      "properties": {
        "id": {
          "$ref": "target.schema.json#/$defs/surfaceId"
        },
        "family": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9]*$"
        },
        "kind": {
          "$ref": "#/$defs/surfaceKind"
        }
      }
    }
  }
}
