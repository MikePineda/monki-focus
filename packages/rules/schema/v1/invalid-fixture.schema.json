{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monkifocus.dev/schema/rules/v1/invalid-fixture.schema.json",
  "title": "InvalidFixture",
  "description": "A document every validator MUST reject, with the rejection code. Kotlin and Swift runners run this kind too. Oversized documents are generated by the runners, never committed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "description", "schema", "document", "then"],
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^invalid\\.[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "kind": {
      "const": "invalid"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "schema": {
      "description": "Schema name the document is validated against.",
      "type": "string",
      "enum": [
        "activity",
        "activity-fixture",
        "bedtime",
        "category-assignment",
        "category-catalog",
        "decision",
        "decision-context",
        "decision-fixture",
        "detector-pack",
        "escalation",
        "escalation-fixture",
        "fixture",
        "invalid-fixture",
        "rule",
        "rule-change-fixture",
        "ruleset",
        "schedule",
        "schedule-fixture",
        "site-profile",
        "surface-registry",
        "target",
        "time",
        "url-normalize-fixture"
      ]
    },
    "document": {
      "description": "The rejected document, deliberately unconstrained here."
    },
    "then": {
      "title": "InvalidThen",
      "type": "object",
      "additionalProperties": false,
      "required": ["rejected", "code"],
      "properties": {
        "rejected": {
          "const": true
        },
        "code": {
          "title": "RejectionCode",
          "type": "string",
          "enum": ["schema", "duplicate_key", "invalid_domain", "too_large", "invalid_json"]
        }
      }
    }
  }
}
