{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monkifocus.dev/schema/rules/v1/rule.schema.json",
  "title": "Rule",
  "description": "One rule of a rule set. `allow`, `friction` and `block` compete on the access axis; `hide-feed` and `allow` compete on the content axis (SEMANTICS.md).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "target", "mode", "schedules", "enabled"],
  "properties": {
    "id": { "$ref": "#/$defs/ruleId" },
    "target": { "$ref": "target.schema.json" },
    "mode": { "$ref": "#/$defs/mode" },
    "schedules": {
      "description": "Empty means always active.",
      "type": "array",
      "maxItems": 14,
      "items": { "$ref": "schedule.schema.json#/$defs/ruleSchedule" }
    },
    "dailyBudgetMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
    "enabled": { "type": "boolean" },
    "note": { "type": "string", "maxLength": 140 }
  },
  "$defs": {
    "ruleId": {
      "title": "RuleId",
      "description": "ASCII id (a ULID or a slug). Ties are broken by code-unit order.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "mode": {
      "title": "RuleMode",
      "type": "string",
      "enum": ["allow", "hide-feed", "friction", "block"]
    }
  }
}
