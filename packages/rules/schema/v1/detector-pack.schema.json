{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monkifocus.dev/schema/rules/v1/detector-pack.schema.json",
  "title": "DetectorPack",
  "description": "Android detector pack: data-only predicates over the accessibility tree that classify a screen into a surface. No scripting and no regex. Packs are signed (Ed25519, offline key) and only accepted with a higher `packVersion`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packId",
    "packVersion",
    "minSchemaVersion",
    "packages",
    "testedAppVersions",
    "unclassifiedCapMinutes",
    "keepVisible",
    "surfaces"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "packVersion": {
      "description": "CalVer `YYYY.MM.DD.n`.",
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]{1,3}$"
    },
    "minSchemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "packages": {
      "description": "Packages the pack applies to; short view ids are prefixed with the matching package.",
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "target.schema.json#/$defs/appPackage"
      }
    },
    "testedAppVersions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "maxLength": 64
      }
    },
    "unclassifiedCapMinutes": {
      "description": "Minutes an unclassified screen of a package with a surface `block` rule may stay before app-level friction applies (0 = off).",
      "type": "integer",
      "minimum": 0,
      "maximum": 240
    },
    "keepVisible": {
      "description": "View ids that a hide-feed cover leaves visible.",
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/viewId"
      }
    },
    "urlBarViewIds": {
      "description": "Browser packs only: view ids of the URL bar, in fallback order.",
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/viewId"
      }
    },
    "surfaces": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/surfaceDetector"
      }
    }
  },
  "$defs": {
    "viewId": {
      "title": "ViewId",
      "description": "Accessibility view id, short (`clips_viewer_view_pager`) or fully qualified (`com.example:id/name`).",
      "type": "string",
      "maxLength": 160,
      "pattern": "^([A-Za-z][A-Za-z0-9_.]*:id/)?[A-Za-z_][A-Za-z0-9_]*$"
    },
    "nodePredicate": {
      "title": "NodePredicate",
      "description": "Matches one node. Needs a view id, text or content description; text fields are literal comparisons, never regex.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "viewId": {
          "$ref": "#/$defs/viewId"
        },
        "contentDesc": {
          "type": "string",
          "maxLength": 160
        },
        "contentDescPrefix": {
          "type": "string",
          "maxLength": 160
        },
        "text": {
          "type": "string",
          "maxLength": 160
        },
        "className": {
          "type": "string",
          "maxLength": 160
        },
        "onScreen": {
          "type": "boolean"
        },
        "selected": {
          "type": "boolean"
        },
        "minHeightRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "anyOf": [
        {
          "required": ["viewId"]
        },
        {
          "required": ["text"]
        },
        {
          "required": ["contentDesc"]
        }
      ]
    },
    "predicateList": {
      "title": "NodePredicateList",
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/nodePredicate"
      },
      "minItems": 1
    },
    "surfaceDetector": {
      "title": "SurfaceDetector",
      "description": "The surface applies when every `all` predicate, at least one `any` predicate (if present) and no `none` predicate match. Detectors are evaluated by descending `priority`, ties by surface id.",
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "priority"],
      "anyOf": [
        {
          "required": ["all"]
        },
        {
          "required": ["any"]
        }
      ],
      "properties": {
        "surface": {
          "$ref": "target.schema.json#/$defs/surfaceId"
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "all": {
          "$ref": "#/$defs/predicateList"
        },
        "any": {
          "$ref": "#/$defs/predicateList"
        },
        "none": {
          "$ref": "#/$defs/predicateList"
        }
      }
    }
  }
}
