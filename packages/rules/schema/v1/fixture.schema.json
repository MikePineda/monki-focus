{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monkifocus.dev/schema/rules/v1/fixture.schema.json",
  "title": "Fixture",
  "description": "Envelope of every conformance fixture: `id` (`<kind>.<spec_name>`, globally unique), `kind`, `description`, then the kind's own shape. An unknown kind is invalid, so every runner fails loudly. `unlock-token` is reserved: its vectors live in packages/protocol.",
  "type": "object",
  "required": ["id", "kind", "description"],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "decision",
        "specificity",
        "url-normalize",
        "schedule",
        "escalation",
        "rule-change",
        "activity",
        "invalid",
        "unlock-token"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": ["decision", "specificity"]
          }
        }
      },
      "then": {
        "$ref": "decision-fixture.schema.json"
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "url-normalize"
          }
        }
      },
      "then": {
        "$ref": "url-normalize-fixture.schema.json"
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "schedule"
          }
        }
      },
      "then": {
        "$ref": "schedule-fixture.schema.json"
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "escalation"
          }
        }
      },
      "then": {
        "$ref": "escalation-fixture.schema.json"
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "rule-change"
          }
        }
      },
      "then": {
        "$ref": "rule-change-fixture.schema.json"
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "activity"
          }
        }
      },
      "then": {
        "$ref": "activity-fixture.schema.json"
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "invalid"
          }
        }
      },
      "then": {
        "$ref": "invalid-fixture.schema.json"
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "unlock-token"
          }
        }
      },
      "then": {
        "description": "Reserved: unlock-token vectors live in packages/protocol, never here.",
        "not": {}
      }
    }
  ]
}
